generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model MoodCheckinResponse {
  id         String   @id @default(uuid()) @db.Char(36)
  answers    String   @db.Text
  mood       Json
  created_at DateTime @default(now())
}

model SelfWorthResponse {
  id         String   @id @default(uuid()) @db.Char(36)
  answers    String   @db.Text
  created_at DateTime @default(now())
}
